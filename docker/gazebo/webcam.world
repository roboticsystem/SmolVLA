<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <!-- 机器人直接内置，绕开 spawn 服务 -->
    <include>
      <uri>model://turtlebot3_waffle_pi</uri>
      <pose>-2.0 -0.5 0.01 0 0 0</pose>
    </include>

    <!-- 俯视观测相机（无惯性块，静态模型） -->
    <model name="overhead_cam">
      <static>true</static>
      <pose>0 0 6 0 1.5708 0</pose>
      <link name="link">
        <sensor type="camera" name="scene_cam">
          <update_rate>5</update_rate>
          <camera>
            <horizontal_fov>1.6</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>50</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <plugin name="camera_ros" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/scene</namespace>
            </ros>
            <camera_name>cam</camera_name>
            <frame_name>map</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
